# =============================================================================
# Lenny Growth Assistant - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys.
# Ollama works without any cloud API keys (local model inference).
# =============================================================================

# Application
APP_NAME=Lenny Growth Assistant
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Database (Docker Compose auto-configures this)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth

# LLM Provider: ollama, openai, anthropic, openrouter
LLM_PROVIDER=openrouter

# Ollama (local model - no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI (get key from https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic (get key from https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# OpenRouter - unified API for 200+ models (get key from https://openrouter.ai/keys)
# Add credits at https://openrouter.ai/credits if you get a 402 error
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Vector Store
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=lenny_transcripts

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
RELEVANCE_THRESHOLD=0.5
EMBEDDING_MODEL=text-embedding-3-small

# Frontend
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
