# ==============================================================================
# Lenny Growth Assistant - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control — only .env.example with safe defaults.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
APP_NAME=Lenny Growth Assistant
APP_ENV=development
DEBUG=true
# Generate a strong random secret for production:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# For local development:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth
# For Docker Compose (password must match POSTGRES_PASSWORD in docker-compose.yml):
# DATABASE_URL=postgresql+asyncpg://postgres:changeme@postgres:5432/lenny_growth
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------
# Options: ollama, openai, anthropic, openrouter
LLM_PROVIDER=openrouter

# Ollama Configuration (Local LLM — mandatory for demo)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI Configuration (Cloud LLM)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Configuration (Cloud LLM)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# OpenRouter Configuration (200+ models via unified API — recommended default)
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key-here
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# Vector Store Configuration
# ------------------------------------------------------------------------------
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=lenny_transcripts

# ------------------------------------------------------------------------------
# RAG Configuration
# ------------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Logging & Observability
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
